<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>io.github.mavenindexdoctor</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Maven Index Doctor</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor>Maven Index Doctor Contributors</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Diagnose and repair IntelliJ IDEA Maven index problems without manually deleting cache directories.<br><br>
        Maven Index Doctor detects failed downloads, unhealthy index files, repository/index inconsistencies,
        mirror and proxy configuration problems, and Maven offline mode. It can retry downloads, refresh or rebuild
        indexes, and safely reset indexes with a restorable backup.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.idea.maven</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="MavenIndexDoctor" factoryClass="io.github.mavenindexdoctor.ui.MavenIndexDoctorToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
        <postStartupActivity implementation="io.github.mavenindexdoctor.monitor.MavenIndexDoctorStartupActivity"/>
        <notificationGroup id="Maven Index Doctor" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

</idea-plugin>
